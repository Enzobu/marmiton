meta {
  name: POST /auth/change-password (change)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "currentPassword": "Fixture-Password42",
    "newPassword": "Changed-Password43"
  }
}

tests {
  test("HTTP 204", () => expect(res.getStatus()).to.equal(204));
}
