meta {
  name: POST /recipes (create)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/recipes
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "recipe": {
      "schemaVersion": 1,
      "title": "Recette HTTP temporaire",
      "description": "Fixture HTTP",
      "category": "Plats",
      "difficulty": "Facile",
      "servings": 2,
      "times": {
        "preparation": 5,
        "cooking": 10,
        "rest": 0
      },
      "budget": "Bon march\u00e9",
      "ingredients": [
        {
          "name": "Farine",
          "quantity": 25,
          "unit": "g"
        },
        {"name": "Whey banane", "quantity": 30, "unit": "g"},
        {"name": "Skyr nature", "quantity": 100, "unit": "g"},
        {"name": "Lait demi-écrémé", "quantity": 200, "unit": "ml"},
        {"name": "Levure chimique", "quantity": 0.5, "unit": "sachet"}
      ],
      "utensils": [
        "Bol"
      ],
      "steps": [
        "M\u00e9langer."
      ],
      "imageUrl": null
    },
    "isPublic": true,
    "photo": "{{limitPhoto}}"
  }
}

script:pre-request {
  // Pad a 1px PNG to exactly 5,000,000 decoded bytes.
  const png = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jCt8AAAAASUVORK5CYII";
  const base64Length = 4 * Math.ceil(5000000 / 3);
  const photo = png + "A".repeat(base64Length - png.split(",")[1].length - 1) + "=";
  bru.setVar("limitPhoto", photo);
}

tests {
  test("HTTP 201", () => expect(res.getStatus()).to.equal(201));
  test("Created UUID", () => { const id = res.getBody().id; expect(id).to.match(/^[a-f0-9-]{36}$/); bru.setVar("recipeId", id); });
  test("Ingredient icon", () => expect(res.getBody().quantities.find(item => item.name === "Farine").icon).to.equal("grain"));
}
