meta {
  name: GET /me/recipes (owned)
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/me/recipes
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Owner has recipes", () => expect(res.getBody()).to.be.an("array"));
}
