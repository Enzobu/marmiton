meta {
  name: PATCH /me/preferences (preferences)
  type: http
  seq: 15
}

patch {
  url: {{baseUrl}}/me/preferences
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "theme": "dark",
    "developerMode": true
  }
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Saved preferences", () => { const body = res.getBody(); expect(body.theme).to.equal("dark"); expect(body.developerMode).to.equal(true); });
}
