meta {
  name: PUT /me/profile (invalid-profile)
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/me/profile
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "firstName": "",
    "lastName": "Owner",
    "bio": "Profil de test HTTP",
    "newsletter": false,
    "publicRecipes": true
  }
}

tests {
  test("HTTP 400", () => expect(res.getStatus()).to.equal(400));
}
