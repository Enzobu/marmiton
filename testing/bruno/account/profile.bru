meta {
  name: PUT /me/profile (profile)
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/me/profile
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "firstName": "Test",
    "lastName": "Owner",
    "bio": "Profil de test HTTP",
    "newsletter": false,
    "publicRecipes": true,
    "photo": "{{limitPhoto}}"
  }
}

script:pre-request {
  // Pad a 1px PNG to exactly 5,000,000 decoded bytes.
  const png = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jCt8AAAAASUVORK5CYII";
  const base64Length = 4 * Math.ceil(5000000 / 3);
  const photo = png + "A".repeat(base64Length - png.split(",")[1].length - 1) + "=";
  bru.setVar("limitPhoto", photo);
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Profile persisted", () => { const profile = res.getBody(); expect(profile.bio).to.equal("Profil de test HTTP"); expect(profile.avatar).to.match(/^\/me\/avatar\//); bru.setVar("avatarPath", profile.avatar.split("/").pop()); });
}
