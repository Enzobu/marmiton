meta {
  name: GET /recipes/00000000-0000-4000-8000-000000000001 (detail)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/recipes/00000000-0000-4000-8000-000000000001
  body: none
  auth: none
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Recipe has quantities and steps", () => { expect(res.getBody().quantities).to.have.lengthOf(5); expect(res.getBody().steps).to.have.lengthOf(3); });
  test("Ingredient icon", () => expect(res.getBody().quantities.find(item => item.name === "Feuilles de lasagne").icon).to.equal("grain"));
}
