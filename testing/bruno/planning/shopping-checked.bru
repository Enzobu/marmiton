meta {
  name: GET /me/shopping-list (shopping-checked)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/me/shopping-list
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Checked item persisted", () => { const data = res.getBody(); expect(data.find(item => item.id === bru.getVar("planningItem")).checked).to.equal(true); });
}
