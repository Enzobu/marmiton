meta {
  name: GET /me/weekly-menu?from=2031-01-06 (menu-after-remove)
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/me/weekly-menu?from=2031-01-06
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Meal is removed", () => { const data = res.getBody(); expect(data.some(item => item.id === bru.getVar("plannedMeal"))).to.equal(false); });
}
