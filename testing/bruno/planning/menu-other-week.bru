meta {
  name: GET /me/weekly-menu?from=2031-01-13 (menu-other-week)
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/me/weekly-menu?from=2031-01-13
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("HTTP 200", () => expect(res.getStatus()).to.equal(200));
  test("Meal is outside the week", () => { const data = res.getBody(); expect(data.some(item => item.id === bru.getVar("plannedMeal"))).to.equal(false); });
}
