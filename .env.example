# Copie locale : cp .env.example .env
# La pile complète démarre avec docker compose up -d --build.
# Ports publiés côté hôte / Dokploy (container web : 80, API : 3001)
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
API_BIND_ADDRESS=127.0.0.1
API_PORT=3001

# API et base de données
DB_NAME=marmiton
DB_USER=marmiton
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Prisma local hors Docker (à renseigner avec le mot de passe réel)
DATABASE_URL=mysql://marmiton:CHANGE_ME@localhost:3306/marmiton
CORS_ORIGIN=http://localhost:5173
# Docker : /api via Nginx. Pour Vite seul, définir VITE_API_URL=http://localhost:3001 dans le shell.
VITE_API_URL=/api

# Chemins persistants ABSOLUS sur l'hôte Dokploy ; créer les dossiers avec les droits adaptés
DB_DATA_PATH=/etc/dokploy_volume/marmiton/mariadb
UPLOADS_PATH=/etc/dokploy_volume/marmiton/uploads
# Lors du lancement hors Docker, le dossier local d’écriture peut être surchargé.
UPLOADS_DIRECTORY=/app/uploads

# Réinitialisation du mot de passe
PUBLIC_WEB_URL=http://localhost:8080
SMTP_FROM_EMAIL=no-reply@enzo-palermo.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Variables de la CI de production (configure-les dans l’environnement GitHub production).
# APP_VERSION_URL=https://marmiton-api.enzo-palermo.com/api/version
