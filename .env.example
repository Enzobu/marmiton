# Copie locale : cp .env.example .env
# L'UI seule démarre avec docker compose up -d --build.
# Ports publiés côté hôte / Dokploy (container web : 80, API : 3001)
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
API_BIND_ADDRESS=127.0.0.1
API_PORT=3001

# API : à activer ultérieurement avec --profile backend
DB_NAME=marmiton
DB_USER=marmiton
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Prisma local hors Docker (à renseigner avec le mot de passe réel)
DATABASE_URL=mysql://marmiton:CHANGE_ME@localhost:3306/marmiton
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001

# Chemins persistants ABSOLUS sur l'hôte Dokploy ; créer les dossiers avec les droits adaptés
DB_DATA_PATH=/etc/dokploy_volume/marmiton/mariadb
UPLOADS_PATH=/etc/dokploy_volume/marmiton/uploads
