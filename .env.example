# Copier vers .env puis renseigner des mots de passe locaux uniques
DB_NAME=marmiton
DB_USER=marmiton
DB_PASSWORD=
DB_ROOT_PASSWORD=
DATABASE_URL=mysql://marmiton:CHANGE_ME@localhost:3306/marmiton
API_PORT=3001
WEB_PORT=8080
# Origines autorisées par le serveur Fastify
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
# Chemins absolus hôte, sous Dokploy par défaut
DB_DATA_PATH=/etc/dokploy_volume/marmiton/mariadb
UPLOADS_PATH=/etc/dokploy_volume/marmiton/uploads
