{
  "name": "marmiton",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @marmiton/web",
    "dev:api": "npm run dev -w @marmiton/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "db:generate": "npm run db:generate -w @marmiton/api",
    "db:migrate": "npm run db:migrate -w @marmiton/api"
  }
}
