generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id           String             @id @default(uuid()) @db.Char(36)
  title        String             @db.VarChar(200)
  description  String             @db.Text
  category     String             @db.VarChar(30)
  difficulty   String             @db.VarChar(10)
  budget       String             @db.VarChar(20)
  servings     Int
  prepMinutes  Int
  cookMinutes  Int
  restMinutes  Int
  totalMinutes Int
  imagePath    String?            @db.VarChar(2048)
  utensils     Json
  rating       Float              @default(0)
  reviews      Int                @default(0)
  badge        String?            @db.VarChar(50)
  isPublic     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ingredients  RecipeIngredient[]
  steps        RecipeStep[]

  @@index([isPublic, category, totalMinutes])
}

model RecipeIngredient {
  recipeId String @db.Char(36)
  position Int
  name     String @db.VarChar(160)
  quantity Decimal? @db.Decimal(14, 6)
  unit     String? @db.VarChar(30)
  icon     String @db.VarChar(20)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, position])
}

model RecipeStep {
  recipeId String @db.Char(36)
  position Int
  content  String @db.Text
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([recipeId, position])
}
